{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run Sirius Entertainment",
      "program": "${workspaceFolder}/server.mjs",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Sirius Entertainment running at (http://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
